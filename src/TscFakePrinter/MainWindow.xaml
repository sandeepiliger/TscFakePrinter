<Window x:Class="TscFakePrinter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TscFakePrinter.ViewModels"
        xmlns:ctl="clr-namespace:TscFakePrinter.Controls"
        Title="TSPL Listener - Fake TSC Printer"
        Height="780" Width="1280"
        MinHeight="640" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================ Header ============================ -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBgBrush}"
                Padding="20,12">
            <StackPanel Orientation="Horizontal">
                <Path Width="22" Height="22" VerticalAlignment="Center"
                      Stretch="Uniform"
                      Fill="{StaticResource HeaderFgBrush}"
                      Data="M3 6h18v2H3zM3 11h18v6H3zm14 2h2v2h-2zM7 18h10v2H7z"/>
                <TextBlock Text="TSPL Listener - Fake TSC Printer"
                           Foreground="{StaticResource HeaderFgBrush}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ============================ Body ============================== -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===================== Left sidebar ===================== -->
            <StackPanel Grid.Column="0">

                <!-- TSPL STATUS -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="TSPL STATUS" Style="{StaticResource SectionHeader}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Width="44" Height="44" CornerRadius="22"
                                    Background="#DCFCE7"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsListening, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Path Width="22" Height="22" Stretch="Uniform"
                                      Fill="{StaticResource SuccessBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M12 2 4 5v6c0 5 3.5 9.5 8 11 4.5-1.5 8-6 8-11V5l-8-3zm-1 14-4-4 1.4-1.4L11 13.2l4.6-4.6L17 10l-6 6z"/>
                            </Border>
                            <Border Width="44" Height="44" CornerRadius="22"
                                    Background="#FEE2E2"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsListening, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <Path Width="22" Height="22" Stretch="Uniform"
                                      Fill="{StaticResource DangerBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M12 2 4 5v6c0 5 3.5 9.5 8 11 4.5-1.5 8-6 8-11V5l-8-3zm-1 6h2v6h-2V8zm0 8h2v2h-2v-2z"/>
                            </Border>

                            <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12">
                                    <Run Text="On Port "/>
                                    <Run Text="{Binding Port, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- LISTENER SETTINGS -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="LISTENER SETTINGS" Style="{StaticResource SectionHeader}"/>

                        <TextBlock Text="IP Address" Style="{StaticResource StatLabel}" Margin="0,4,0,4"/>
                        <ComboBox ItemsSource="{Binding Interfaces}"
                                  SelectedItem="{Binding SelectedInterface}"
                                  IsEnabled="{Binding IsListening, Converter={StaticResource InverseBooleanConverter}}"/>

                        <TextBlock Text="Port" Style="{StaticResource StatLabel}" Margin="0,10,0,4"/>
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource PortTextBox}"
                                 IsEnabled="{Binding IsListening, Converter={StaticResource InverseBooleanConverter}}"/>

                        <Button Content="{Binding ToggleButtonText}"
                                Command="{Binding ToggleListenerCommand}"
                                Margin="0,14,0,0"
                                Height="38">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SuccessButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsListening}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- STATISTICS -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="STATISTICS" Style="{StaticResource SectionHeader}"/>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Total Connections" Style="{StaticResource StatLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Stats.TotalConnections}" Style="{StaticResource StatValue}"/>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Total Commands Received" Style="{StaticResource StatLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Stats.TotalCommands}" Style="{StaticResource StatValue}"/>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Total Bytes Received" Style="{StaticResource StatLabel}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Stats.TotalBytes, Converter={StaticResource BytesFormatConverter}}"
                                       Style="{StaticResource StatValue}"/>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Start Time" Style="{StaticResource StatLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Stats.StartTimeText}" Style="{StaticResource StatValue}"/>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Uptime" Style="{StaticResource StatLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Uptime}" Style="{StaticResource StatValue}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===================== Right main pane ===================== -->
            <Grid Grid.Column="1" Margin="16,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="240"/>
                </Grid.RowDefinitions>

                <!-- Top: Received commands + Preview -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- Received TSPL Commands -->
                    <Border Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Toolbar -->
                            <Grid Grid.Row="0" Margin="14,12,14,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="RECEIVED TSPL COMMANDS"
                                           Style="{StaticResource SectionHeader}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Clear"
                                            Command="{Binding ClearCommand}"
                                            Style="{StaticResource SubtleButton}"
                                            Margin="0,0,8,0"/>
                                    <Button Content="Save As..."
                                            Command="{Binding SaveAsCommand}"
                                            Style="{StaticResource SubtleButton}"
                                            Margin="0,0,12,0"/>
                                    <CheckBox Content="Auto Scroll"
                                              IsChecked="{Binding AutoScroll}"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Code area -->
                            <Border Grid.Row="1"
                                    Background="{StaticResource CodeBgBrush}"
                                    Margin="14,0,14,0"
                                    CornerRadius="6">
                                <TextBox x:Name="CommandsTextBox"
                                         Text="{Binding ReceivedText, Mode=OneWay}"
                                         IsReadOnly="True"
                                         FontFamily="Consolas, Cascadia Mono, Courier New"
                                         FontSize="12"
                                         Foreground="{StaticResource CodeFgBrush}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="10"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextWrapping="NoWrap"
                                         TextChanged="CommandsTextBox_TextChanged"/>
                            </Border>

                            <!-- Footer bytes/lines -->
                            <Grid Grid.Row="2" Margin="14,8,14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11">
                                    <Run Text="Bytes:"/>
                                    <Run Text="{Binding CurrentBytes}" FontWeight="SemiBold"/>
                                </TextBlock>
                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11">
                                    <Run Text="Lines:"/>
                                    <Run Text="{Binding CurrentLines}" FontWeight="SemiBold"/>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Preview pane -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TabControl Grid.Row="0" Grid.RowSpan="2"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Padding="14">
                                <TabItem Header="Raw">
                                    <TextBox Text="{Binding ReceivedText, Mode=OneWay}"
                                             IsReadOnly="True"
                                             FontFamily="Consolas, Cascadia Mono, Courier New"
                                             FontSize="11"
                                             BorderThickness="0"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             TextWrapping="NoWrap"
                                             Background="Transparent"/>
                                </TabItem>
                                <TabItem Header="Formatted">
                                    <TextBox Text="{Binding FormattedText, Mode=OneWay}"
                                             IsReadOnly="True"
                                             FontFamily="Consolas, Cascadia Mono, Courier New"
                                             FontSize="11"
                                             BorderThickness="0"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             TextWrapping="NoWrap"
                                             Background="Transparent"/>
                                </TabItem>
                                <TabItem Header="Preview" IsSelected="True">
                                    <ctl:LabelPreviewControl Document="{Binding CurrentDocument}"/>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Connection history -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="CONNECTION HISTORY"
                                   Style="{StaticResource SectionHeader}"
                                   Margin="14,12,14,4"/>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding History}"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F8FAFC"
                                  Margin="6,0,6,6">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50"/>
                                <DataGridTextColumn Header="Client IP" Binding="{Binding ClientIp}" Width="160"/>
                                <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="80"/>
                                <DataGridTextColumn Header="Received Time" Binding="{Binding ReceivedAtText}" Width="120"/>
                                <DataGridTextColumn Header="Bytes" Binding="{Binding BytesText}" Width="90"/>
                                <DataGridTextColumn Header="Lines" Binding="{Binding Lines}" Width="70"/>
                                <DataGridTextColumn Header="Preview" Binding="{Binding PreviewSnippet}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================ Footer ============================ -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="TSPL Listener v1.0.0"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding FooterStatus}"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                             VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsListening}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center">
                        <Run Text="{Binding StatusText}"/>
                        <Run Text=" on Port "/>
                        <Run Text="{Binding Port, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
