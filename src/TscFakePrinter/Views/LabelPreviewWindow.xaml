<Window x:Class="TscFakePrinter.Views.LabelPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:TscFakePrinter.Controls"
        Title="Label Preview"
        Height="640" Width="900"
        MinHeight="360" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13">

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Zoom"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Margin="0,0,8,0"/>
                    <Button Content="−"
                            Click="ZoomOut_Click"
                            Style="{StaticResource SubtleButton}"
                            Width="30" Height="28"
                            Padding="0"
                            Margin="0,0,4,0"/>
                    <Slider x:Name="ZoomSlider"
                            Minimum="0.4"
                            Maximum="6"
                            Value="1"
                            Width="240"
                            TickFrequency="0.1"
                            IsSnapToTickEnabled="False"
                            VerticalAlignment="Center"/>
                    <Button Content="+"
                            Click="ZoomIn_Click"
                            Style="{StaticResource SubtleButton}"
                            Width="30" Height="28"
                            Padding="0"
                            Margin="4,0,8,0"/>
                    <TextBlock VerticalAlignment="Center"
                               MinWidth="44"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Text="{Binding ElementName=ZoomSlider, Path=Value, StringFormat={}{0:P0}}"/>
                    <Button Content="Fit"
                            Click="ResetZoom_Click"
                            Style="{StaticResource SubtleButton}"
                            Margin="12,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding CurrentDocument, Converter={x:Static ctl:DocumentSizeConverter.Instance}}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"/>

                <Button Grid.Column="2"
                        Content="Close"
                        Click="Close_Click"
                        Style="{StaticResource SubtleButton}"/>
            </Grid>
        </Border>

        <!-- Scrollable preview -->
        <Border Background="#E2E8F0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Padding="20">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ctl:LabelPreviewControl x:Name="Preview"
                                              Document="{Binding CurrentDocument}">
                        <ctl:LabelPreviewControl.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding ElementName=ZoomSlider, Path=Value}"
                                            ScaleY="{Binding ElementName=ZoomSlider, Path=Value}"/>
                        </ctl:LabelPreviewControl.LayoutTransform>
                    </ctl:LabelPreviewControl>
                </Grid>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
